[gd_resource type="Resource" script_class="ProgressionCatalog" load_steps=16 format=3]

[ext_resource type="Script" path="res://features/progression/progression_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://features/progression/currency_definition.gd" id="2_currency"]
[ext_resource type="Script" path="res://features/progression/upgrade_definition.gd" id="3_upgrade"]
[ext_resource type="Script" path="res://features/progression/upgrade_requirement.gd" id="4_requirement"]
[ext_resource type="Script" path="res://features/progression/stat_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Currency_gold"]
script = ExtResource("2_currency")
id = &"gold"
display_name = "Gold"
description = "Coins carried home from completed runs."
display_color = Color(0.95, 0.78, 0.25, 1)

[sub_resource type="Resource" id="Currency_insight"]
script = ExtResource("2_currency")
id = &"insight"
display_name = "Insight"
description = "Rare knowledge that unlocks deeper improvements."
display_color = Color(0.45, 0.8, 0.92, 1)

[sub_resource type="Resource" id="Effect_reward"]
script = ExtResource("5_effect")
stat_id = &"run_reward_multiplier"
operation = 1
value = 1.15

[sub_resource type="Resource" id="Effect_health"]
script = ExtResource("5_effect")
stat_id = &"starting_health"
value = 2.0

[sub_resource type="Resource" id="Effect_capacity"]
script = ExtResource("5_effect")
stat_id = &"carry_capacity"
value = 5.0

[sub_resource type="Resource" id="Effect_speed"]
script = ExtResource("5_effect")
stat_id = &"run_speed"
value = 18.0

[sub_resource type="Resource" id="Requirement_satchel"]
script = ExtResource("4_requirement")
upgrade_id = &"lucky_satchel"

[sub_resource type="Resource" id="Requirement_rations"]
script = ExtResource("4_requirement")
upgrade_id = &"trail_rations"

[sub_resource type="Resource" id="Upgrade_satchel"]
script = ExtResource("3_upgrade")
id = &"lucky_satchel"
display_name = "Lucky Satchel"
description = "Bring home more from every future run."
costs = {"gold": 15}
effects = Array[ExtResource("5_effect")]([SubResource("Effect_reward")])
tree_position = Vector2(16, 52)

[sub_resource type="Resource" id="Upgrade_rations"]
script = ExtResource("3_upgrade")
id = &"trail_rations"
display_name = "Trail Rations"
description = "Begin each run with a little more health."
costs = {"gold": 25, "insight": 1}
prerequisites = Array[ExtResource("4_requirement")]([SubResource("Requirement_satchel")])
effects = Array[ExtResource("5_effect")]([SubResource("Effect_health")])
tree_position = Vector2(154, 10)

[sub_resource type="Resource" id="Upgrade_pockets"]
script = ExtResource("3_upgrade")
id = &"deep_pockets"
display_name = "Deep Pockets"
description = "Carry more resources per run."
costs = {"gold": 20}
max_level = 3
cost_growth = 1.4
prerequisites = Array[ExtResource("4_requirement")]([SubResource("Requirement_satchel")])
effects = Array[ExtResource("5_effect")]([SubResource("Effect_capacity")])
tree_position = Vector2(154, 94)

[sub_resource type="Resource" id="Upgrade_pathfinder"]
script = ExtResource("3_upgrade")
id = &"pathfinder"
display_name = "Pathfinder"
description = "Move faster through every future run."
costs = {"gold": 45, "insight": 2}
prerequisites = Array[ExtResource("4_requirement")]([SubResource("Requirement_rations")])
effects = Array[ExtResource("5_effect")]([SubResource("Effect_speed")])
tree_position = Vector2(292, 10)

[resource]
script = ExtResource("1_catalog")
currencies = Array[ExtResource("2_currency")]([SubResource("Currency_gold"), SubResource("Currency_insight")])
upgrades = Array[ExtResource("3_upgrade")]([SubResource("Upgrade_satchel"), SubResource("Upgrade_rations"), SubResource("Upgrade_pockets"), SubResource("Upgrade_pathfinder")])
