; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Jam Foundation"
run/main_scene="res://app/foundation_hub.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputActions="*res://features/input/input_actions.gd"
SaveStore="*res://features/save/save_store.gd"
Progression="*res://features/progression/progression_service.gd"
AudioSettings="*res://features/audio/audio_settings.gd"
SceneRouter="*res://app/scene_router.gd"
AppShell="*res://app/app_shell.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[audio]

default_bus_layout="res://features/audio/default_bus_layout.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.082, 0.071, 1)
2d/snap/snap_2d_transforms_to_pixel=true
