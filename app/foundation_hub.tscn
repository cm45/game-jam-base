[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://ui/theme/game_jam_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://app/foundation_hub.gd" id="2_script"]

[node name="FoundationHub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.047, 0.082, 0.071, 1)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(470, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 4

[node name="Layout" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "GAME JAM FOUNDATION"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
text = "Milestone 5: replaceable game starter"
horizontal_alignment = 1

[node name="Divider" type="HSeparator" parent="Center/Panel/Margin/Layout"]
layout_mode = 2

[node name="Description" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
text = "Start from a walkable home, complete a small run,\nand use the RunContext / RunResult handoff as your template."
horizontal_alignment = 1

[node name="StarterButton" type="Button" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "OPEN STARTER GAME"

[node name="PreviewButton" type="Button" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "OPEN FOUNDATION PREVIEW"

[node name="ProgressionButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "OPEN PROGRESSION LAB"

[node name="SettingsButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "SETTINGS"

[node name="ControlsButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "KEYBINDS"

[node name="QuitButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
text = "QUIT"

[node name="Hint" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
text = "WASD or arrow keys move. E interacts. Escape opens the pause menu."
horizontal_alignment = 1

[connection signal="pressed" from="Center/Panel/Margin/Layout/StarterButton" to="." method="_on_starter_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/PreviewButton" to="." method="_on_preview_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/ProgressionButton" to="." method="_on_progression_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/ControlsButton" to="." method="_on_controls_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/QuitButton" to="." method="_on_quit_button_pressed"]
