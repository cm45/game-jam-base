[connection signal="pressed" from="Center/Panel/Margin/Layout/StarterButton" to="." method="_on_starter_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/PreviewButton" to="." method="_on_preview_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/ProgressionButton" to="." method="_on_progression_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/Layout/ControlsButton" to="." method="_on_controls_button_pressed"]
