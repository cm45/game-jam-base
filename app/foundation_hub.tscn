[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://ui/theme/game_jam_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://app/foundation_hub.gd" id="2_script"]
[ext_resource type="Font" path="res://ui/theme/readable_body_font.tres" id="4_body_font"]

[node name="FoundationHub" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.047, 0.082, 0.071, 1)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Layout" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "GAME JAM FOUNDATION"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_body_font")
theme_override_font_sizes/font_size = 20
text = "A flexible pixel-art starting point"
horizontal_alignment = 1

[node name="Divider" type="HSeparator" parent="Center/Panel/Margin/Layout"]
layout_mode = 2

[node name="Description" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_body_font")
theme_override_font_sizes/font_size = 20
text = "Explore the camp, then make the loop your own."
horizontal_alignment = 1

[node name="StarterButton" type="Button" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "PLAY STARTER CAMP"

[node name="PreviewButton" type="Button" parent="Center/Panel/Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "FOUNDATION TOUR"

[node name="ProgressionButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "PROGRESSION LAB"

[node name="SettingsButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "SETTINGS"

[node name="ControlsButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "KEYBINDS"

[node name="QuitButton" type="Button" parent="Center/Panel/Margin/Layout"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "QUIT"

[node name="Hint" type="Label" parent="Center/Panel/Margin/Layout"]
layout_mode = 2
